{
  "name": "challenge-cloudsec-meli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "db:up": "tsx src/db/local.ts up",
    "db:migrate": "tsx src/db/local.ts migrate",
    "db:test": "tsx src/db/local.ts test",
    "db:test:node": "node --env-file-if-exists=.env --import tsx --test test/database.integration.ts",
    "db:check": "tsx --env-file-if-exists=.env src/db/check.ts",
    "db:stop": "tsx src/db/local.ts stop"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
